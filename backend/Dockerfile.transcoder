FROM golang:latest AS builder

WORKDIR /app

# Copy go mod and sum files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the transcoder binary with CGO_ENABLED=0 for compatibility
RUN CGO_ENABLED=0 GOOS=linux go build -o transcoder cmd/transcoder/main.go

# Final stage
FROM ubuntu:22.04

WORKDIR /app

# Install FFmpeg and certificates
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y ffmpeg ca-certificates tzdata && \
    rm -rf /var/lib/apt/lists/*

# Copy the binary from builder
COPY --from=builder /app/transcoder .

# Run the transcoder
CMD ["./transcoder"]
